# Backend configuration
# Set this to the IP address or hostname of the machine running the backend
# Examples:
#   VITE_BACKEND_HOST=192.168.1.100
#   VITE_BACKEND_HOST=backend.local
#   VITE_BACKEND_HOST=mycomputer.home
# If not set, will default to the current page's hostname
VITE_BACKEND_HOST=localhost
